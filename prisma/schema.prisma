// LifeOS — personal mode schema (Phase 1)
// Source of truth: 기획서 v2.0 §10
// Note: User.id is the Supabase auth.users UUID (no FK constraint at DB level
// because the auth schema lives in the `auth` namespace — we mirror the value).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// === User & profile ===

model User {
  id            String         @id @db.Uuid
  email         String         @unique
  name          String?
  image         String?

  height        Float?
  weight        Float?

  assistantName String         @default("나비")
  assistantTone AssistantTone  @default(FRIENDLY)

  // Notification preferences (§7.2.2 방해 금지 시간)
  pushEnabled   Boolean        @default(false)
  dndStart      String         @default("23:00")   // "HH:mm"
  dndEnd        String         @default("07:00")
  timezone      String         @default("Asia/Seoul")

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  onboardedAt   DateTime?      // null until the welcome flow completes

  events             Event[]
  routines           Routine[]
  weightLogs         WeightLog[]
  workouts           Workout[]
  aiInteractions     AIInteraction[]
  pushSubscriptions  PushSubscription[]

  initiatedPartnerships Partnership[] @relation("PartnershipOwner")
  invitedToPartnerships Partnership[] @relation("PartnershipPartner")

  @@map("users")
}

// Web Push subscription (one user can have many devices)
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String   @db.Uuid
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  lastSeenAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

enum AssistantTone {
  FRIENDLY
  POLITE
  FUN
  STRICT
}

// === Calendar ===

model Event {
  id          String          @id @default(cuid())
  userId      String          @db.Uuid
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime
  isAllDay    Boolean         @default(false)
  category    EventCategory   @default(PERSONAL)
  color       String?
  recurrence  RecurrenceType  @default(NONE)
  reminder    Int?

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startDate])
  @@map("events")
}

enum EventCategory {
  WORK
  PERSONAL
  HEALTH
  EXERCISE
  MEDICAL
  STUDY
  OTHER
}

enum RecurrenceType {
  NONE
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

// === Routines ===

model Routine {
  id              String           @id @default(cuid())
  userId          String           @db.Uuid
  title           String
  description     String?
  timeOfDay       TimeOfDay
  customTime      String?
  category        RoutineCategory  @default(OTHER)
  daysOfWeek      Int[]
  reminderEnabled Boolean          @default(true)
  createdAt       DateTime         @default(now())

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs            RoutineLog[]

  @@index([userId])
  @@map("routines")
}

enum TimeOfDay {
  MORNING
  AFTERNOON
  EVENING
  NIGHT
  CUSTOM
}

enum RoutineCategory {
  MEDICATION
  EXERCISE
  MINDSET
  HYGIENE
  OTHER
}

model RoutineLog {
  id          String    @id @default(cuid())
  routineId   String
  date        DateTime  @db.Date
  completed   Boolean   @default(false)
  completedAt DateTime?

  routine     Routine   @relation(fields: [routineId], references: [id], onDelete: Cascade)

  @@unique([routineId, date])
  @@map("routine_logs")
}

// === Workout ===

model Workout {
  id        String       @id @default(cuid())
  userId    String       @db.Uuid
  type      WorkoutType
  bodyPart  BodyPart?
  startedAt DateTime
  endedAt   DateTime?
  duration  Int?
  calories  Int?
  notes     String?

  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercises Exercise[]

  @@index([userId, startedAt])
  @@map("workouts")
}

enum WorkoutType {
  GYM
  CARDIO
  YOGA
  SWIMMING
  BALL
  OTHER
}

enum BodyPart {
  CHEST
  BACK
  LEGS
  SHOULDERS
  ARMS
  ABS
}

model Exercise {
  id        String        @id @default(cuid())
  workoutId String
  name      String
  bodyPart  BodyPart?

  workout   Workout       @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  sets      ExerciseSet[]

  @@map("exercises")
}

model ExerciseSet {
  id         String   @id @default(cuid())
  exerciseId String
  setNumber  Int
  weight     Float?
  reps       Int?
  completed  Boolean  @default(false)

  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@map("exercise_sets")
}

model WeightLog {
  id         String   @id @default(cuid())
  userId     String   @db.Uuid
  weight     Float
  bodyFat    Float?
  muscleMass Float?
  date       DateTime @db.Date
  note       String?

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("weight_logs")
}

// === AI assistant ===

model AIInteraction {
  id        String          @id @default(cuid())
  userId    String          @db.Uuid
  type      InteractionType
  content   String
  response  String?
  createdAt DateTime        @default(now())

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("ai_interactions")
}

enum InteractionType {
  CHAT
  NOTIFICATION
  RECOMMENDATION
  INSIGHT
}

// === Shared mode (Phase 3) ===

model Partnership {
  id          String   @id @default(cuid())
  ownerId     String   @db.Uuid
  partnerId   String?  @db.Uuid
  inviteCode  String   @unique
  status      PartnershipStatus @default(PENDING)
  startedAt   DateTime?
  createdAt   DateTime @default(now())

  owner       User     @relation("PartnershipOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  partner     User?    @relation("PartnershipPartner", fields: [partnerId], references: [id], onDelete: SetNull)

  chores      Chore[]
  shoppingItems ShoppingItem[]
  sharedEvents SharedEvent[]
  sharedGoals  SharedGoal[]
  thankYous    ThankYou[]
  expenses    Expense[]

  @@index([ownerId])
  @@index([partnerId])
  @@map("partnerships")
}

enum PartnershipStatus {
  PENDING
  ACTIVE
  PAUSED
}

model Chore {
  id              String   @id @default(cuid())
  partnershipId   String
  title           String
  emoji           String?
  frequency       ChoreFrequency
  daysOfWeek      Int[]
  assignmentType  AssignmentType  @default(ALTERNATE)
  fixedAssigneeId String?  @db.Uuid
  estimatedTime   Int?     // minutes
  createdAt       DateTime @default(now())

  partnership     Partnership @relation(fields: [partnershipId], references: [id], onDelete: Cascade)
  logs            ChoreLog[]

  @@index([partnershipId])
  @@map("chores")
}

enum ChoreFrequency {
  DAILY
  WEEKLY
  MONTHLY
  CUSTOM
}

enum AssignmentType {
  FIXED
  ALTERNATE
  BY_DAY
  ROULETTE
}

model ChoreLog {
  id          String   @id @default(cuid())
  choreId     String
  assignedToId String  @db.Uuid
  completedById String? @db.Uuid
  completedAt DateTime?
  date        DateTime @db.Date

  chore       Chore    @relation(fields: [choreId], references: [id], onDelete: Cascade)

  @@unique([choreId, date])
  @@index([assignedToId])
  @@map("chore_logs")
}

model ShoppingItem {
  id              String   @id @default(cuid())
  partnershipId   String
  name            String
  quantity        String?
  category        ShoppingCategory?
  addedById       String   @db.Uuid
  purchased       Boolean  @default(false)
  purchasedById   String?  @db.Uuid
  purchasedAt     DateTime?
  note            String?
  createdAt       DateTime @default(now())

  partnership     Partnership @relation(fields: [partnershipId], references: [id], onDelete: Cascade)

  @@index([partnershipId, purchased])
  @@map("shopping_items")
}

enum ShoppingCategory {
  FRESH
  MEAT
  BAKERY
  DAILY
  HYGIENE
  SNACK
  DRINK
  OTHER
}

model SharedEvent {
  id              String   @id @default(cuid())
  partnershipId   String
  title           String
  description     String?
  startDate       DateTime
  endDate         DateTime
  isAllDay        Boolean  @default(false)
  category        SharedEventCategory @default(DATE)
  isAnniversary   Boolean  @default(false)
  createdById     String   @db.Uuid

  partnership     Partnership @relation(fields: [partnershipId], references: [id], onDelete: Cascade)

  @@index([partnershipId, startDate])
  @@map("shared_events")
}

enum SharedEventCategory {
  DATE
  FAMILY
  ANNIVERSARY
  MEDICAL
  ENTERTAINMENT
  TRAVEL
}

model SharedGoal {
  id              String   @id @default(cuid())
  partnershipId   String
  title           String
  emoji           String?
  category        GoalCategory @default(LIFE)
  targetAmount    Float?
  currentAmount   Float    @default(0)
  targetDate      DateTime?
  completedAt     DateTime?
  createdAt       DateTime @default(now())

  partnership     Partnership @relation(fields: [partnershipId], references: [id], onDelete: Cascade)

  @@index([partnershipId])
  @@map("shared_goals")
}

enum GoalCategory {
  FINANCE
  TRAVEL
  LIFE
  HEALTH
  LEARNING
  OTHER
}

model ThankYou {
  id                String   @id @default(cuid())
  partnershipId     String
  fromUserId        String   @db.Uuid
  toUserId          String   @db.Uuid
  message           String
  relatedChoreLogId String?
  createdAt         DateTime @default(now())

  partnership       Partnership @relation(fields: [partnershipId], references: [id], onDelete: Cascade)

  @@index([partnershipId, createdAt])
  @@map("thank_yous")
}

// === Expense / 가계부 (§6.4) ===

model Expense {
  id            String          @id @default(cuid())
  partnershipId String
  amount        Int             // KRW, 원 단위 정수
  category      ExpenseCategory @default(OTHER)
  description   String?
  paidById      String          @db.Uuid
  date          DateTime        @db.Date
  createdAt     DateTime        @default(now())

  partnership   Partnership     @relation(fields: [partnershipId], references: [id], onDelete: Cascade)

  @@index([partnershipId, date])
  @@map("expenses")
}

enum ExpenseCategory {
  FOOD
  TRANSPORT
  HOUSING
  ENTERTAINMENT
  SHOPPING
  HEALTH
  OTHER
}
